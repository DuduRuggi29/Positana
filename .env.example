# Mercado Pago (nova conta / novo ID)
# Access Token privado (server-side) - usado em api/*.js
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx

# Supabase (novo projeto / novo ID)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública do site (usada para montar a notification_url do webhook do MP)
SITE_URL=https://www.seudominio.com.br

# Painel /dashboard
DASHBOARD_PASSWORD=troque-esta-senha

# Z-API (WhatsApp) - opcional, mantém a mesma conta se não for trocar
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Bling (NF-e) - opcional, mantém a mesma conta se não for trocar
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Stripe (create-payment-intent.js) - opcional, só se usar esse fluxo
STRIPE_SECRET_KEY=
